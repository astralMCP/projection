{
  "name": "mccircuit",
  "version": "0.1.0",
  "description": "Turn any MCP server into a code-mode server with human-approved side effects, built on MCP MRTR and XState v5.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@sebastianwessel/quickjs": "3.1.0",
    "xstate": "5.32.5",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsdown": "^0.22.14",
    "unrun": "^0.3.1",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "mcp",
    "code-mode",
    "xstate",
    "quickjs",
    "sandbox",
    "mrtr"
  ],
  "publishConfig": {
    "access": "public"
  }
}
