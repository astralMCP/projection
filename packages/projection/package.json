{
  "name": "@astral-mcp/projection",
  "version": "0.9.0",
  "description": "Wrap any MCP server in code mode (LLM-authored XState workflows) and a tool catalog (search, describe, call), with human-approved side effects over MCP MRTR (Multi Round-Trip Requests).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@sebastianwessel/quickjs": "3.1.0",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "^5.7.0",
    "xstate": "5.32.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "micromark": "^4.0.3",
    "tsdown": "^0.23.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "mcp",
    "code-mode",
    "xstate",
    "quickjs",
    "sandbox",
    "mrtr"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astralMCP/projection.git",
    "directory": "packages/projection"
  },
  "homepage": "https://github.com/astralMCP/projection#readme",
  "bugs": "https://github.com/astralMCP/projection/issues",
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  }
}
