{
  "name": "@astral-mcp/tui",
  "version": "0.1.0",
  "private": true,
  "description": "Ink terminal client for exploratory Projection testing: type a task, watch authored machines run, approve/deny elicitations with single keys.",
  "type": "module",
  "bin": {
    "projection-tui": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "start": "pnpm -w exec turbo run build --filter=@astral-mcp/tui... --output-logs=errors-only && node dist/cli.mjs"
  },
  "dependencies": {
    "@astral-mcp/harness": "workspace:*",
    "@astral-mcp/projection": "workspace:*",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.0",
    "unrun": "^0.3.1",
    "vitest": "^3.2.0"
  }
}
