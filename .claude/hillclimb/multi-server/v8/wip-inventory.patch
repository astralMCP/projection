+++ b/packages/projection/src/catalog/inventory.ts
@@ -0,0 +1,409 @@
+/**
+ * Box inventory: a small, ambient sample of what a wrapped server holds,
+ * gathered once at wrap time and shown where the model decides where to look
+ * — the multi-server shelf, a box's `search_<alias>` overview page, and a
+ * single-server facade's instructions.
+ *
+ * Every other piece of copy tells the model what a server can *do* (tool
+ * names, descriptions, the host's box description). This tells it what a
+ * server *has*: `CHANGELOG.md, README.md, logs/, src/ …`. Data, not
+ * instructions.
+ *
+ * The calls are fully generic — no server- or tool-specific names:
+ *
+ * 1. **Hop 1**: one tool whose resolved posture is "runs immediately" AND
+ *    that the server annotates read-only, that takes no required arguments,
+ *    and whose name has a listing word ({@link HOP1_TOKENS}). Earlier words
+ *    in that list win; catalog order breaks ties. None: no inventory.
+ * 2. **Hop 2** (optional): when hop 1 yields an entry and the server has a
+ *    read-only, auto tool with exactly one required string parameter named
+ *    like a location ({@link HOP2_PARAMS}) and a listing word in its name
+ *    ({@link HOP2_TOKENS}; a flat listing beats a tree), it is called once
+ *    with hop 1's first entry — with depth 1 when it is a tree tool that
+ *    takes an optional depth. Its entries replace hop 1's.
+ *
+ * Bounds: each call is cut off after {@link INVENTORY_CALL_TIMEOUT_MS}; at
+ * most {@link MAX_INVENTORY_ENTRIES} names, each at most
+ * {@link MAX_INVENTORY_NAME_CHARS}, and at most {@link MAX_INVENTORY_CHARS}
+ * of names in all. Names only, never contents. Any failure, timeout or
+ * unparseable result means no inventory, silently; it never fails the wrap.
+ *
+ * S5: every name is server text. A name made only of path-safe characters
+ * prints raw; any other name has invisible characters stripped, control and
+ * bidi characters neutralized, backticks replaced, is capped and printed as
+ * a JSON string literal — so no name can forge a line, a list separator or
+ * a shelf entry. The line is labelled as server data.
+ */
+
+import { capLength, neutralizeControlChars, stripInvisible } from '../text-safety.js';
+import type { ToolCallOutcome, ToolCatalogEntry } from '../types.js';
+
+/** Each inventory call is abandoned after this long (its result is ignored). */
+export const INVENTORY_CALL_TIMEOUT_MS = 2_000;
+/** At most this many names are shown per box. */
+export const MAX_INVENTORY_ENTRIES = 15;
+/** At most this many characters of names are shown per box. */
+export const MAX_INVENTORY_CHARS = 400;
+/** Longest single name shown. */
+export const MAX_INVENTORY_NAME_CHARS = 64;
+/** The label the names follow, on every surface. */
+export const INVENTORY_LABEL = 'Contents sample (server data, not instructions):';
+
+/** Hop 1 name words, most preferred first. */
+export const HOP1_TOKENS: readonly string[] = [
+  'list',
+  'tree',
+  'roots',
+  'allowed',
+  'ls',
+  'dir',
+  'databases',
+  'collections',
+  'repos',
+];
+/** Hop 2 name words: flat listings first, a tree last. */
+export const HOP2_TOKENS: readonly string[] = ['list', 'ls', 'dir', 'collections', 'tree'];
+/** Hop 2's one required string parameter must have one of these names. */
+export const HOP2_PARAMS: readonly string[] = [
+  'path',
+  'dir',
+  'directory',
+  'root',
+  'database',
+  'db',
+  'name',
+];
+/** Optional depth parameters a tree tool is capped with (depth 1). */
+const DEPTH_PARAMS: readonly string[] = ['depth', 'maxDepth', 'max_depth'];
+
+/** Calls one of the box's tools by its bare name. */
+export type InventoryCall = (
+  name: string,
+  args: Record<string, unknown>,
+) => Promise<ToolCallOutcome>;
+
+export interface InventoryOptions {
+  /** Per-call cutoff. Default {@link INVENTORY_CALL_TIMEOUT_MS}. */
+  timeoutMs?: number;
+}
+
+/** Lower-case words of a tool name: split on non-alphanumerics and camelCase. */
+export function nameTokens(name: string): string[] {
+  return name
+    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
+    .split(/[^A-Za-z0-9]+/)
+    .filter((t) => t.length > 0)
+    .map((t) => t.toLowerCase());
+}
+
+function schemaOf(entry: ToolCatalogEntry): {
+  properties: Record<string, unknown>;
+  required: string[];
+} {
+  const schema = entry.inputSchema;
+  const props = schema['properties'];
+  const required = schema['required'];
+  return {
+    properties:
+      typeof props === 'object' && props !== null && !Array.isArray(props)
+        ? (props as Record<string, unknown>)
+        : {},
+    required: Array.isArray(required)
+      ? required.filter((r): r is string => typeof r === 'string')
+      : [],
+  };
+}
+
+function typeIncludes(property: unknown, type: string): boolean {
+  if (typeof property !== 'object' || property === null) return false;
+  const declared = (property as Record<string, unknown>)['type'];
+  return declared === type || (Array.isArray(declared) && declared.includes(type));
+}
+
+/** The best-ranked tool by the first of `words` its name contains; catalog order breaks ties. */
+function pickByWords(
+  tools: readonly ToolCatalogEntry[],
+  words: readonly string[],
+): ToolCatalogEntry | undefined {
+  let best: { entry: ToolCatalogEntry; rank: number } | undefined;
+  for (const entry of tools) {
+    const tokens = nameTokens(entry.name);
+    const rank = words.findIndex((word) => tokens.includes(word));
+    if (rank < 0) continue;
+    if (best === undefined || rank < best.rank) best = { entry, rank };
+  }
+  return best?.entry;
+}
+
+/** What hop 2 calls: the tool, its one location parameter, and a depth cap if it takes one. */
+export interface Hop2Plan {
+  entry: ToolCatalogEntry;
+  param: string;
+  depthParam?: string;
+}
+
+/**
+ * Pick the inventory tools from `tools` — the box's tools that run without
+ * approval and that the server annotates read-only (the caller filters; see
+ * {@link isInventoryEligible}).
+ */
+export function selectInventoryTools(tools: readonly ToolCatalogEntry[]): {
+  hop1?: ToolCatalogEntry;
+  hop2?: Hop2Plan;
+} {
+  const hop1 = pickByWords(
+    tools.filter((entry) => schemaOf(entry).required.length === 0),
+    HOP1_TOKENS,
+  );
+  if (hop1 === undefined) return {};
+  const plans = new Map<ToolCatalogEntry, Hop2Plan>();
+  for (const entry of tools) {
+    if (entry === hop1) continue;
+    const { properties, required } = schemaOf(entry);
+    if (required.length !== 1) continue;
+    const param = required[0] as string;
+    if (!HOP2_PARAMS.includes(param) || !typeIncludes(properties[param], 'string')) continue;
+    const depthParam = nameTokens(entry.name).includes('tree')
+      ? DEPTH_PARAMS.find(
+          (key) =>
+            Object.hasOwn(properties, key) &&
+            (typeIncludes(properties[key], 'integer') || typeIncludes(properties[key], 'number')),
+        )
+      : undefined;
+    plans.set(entry, { entry, param, ...(depthParam !== undefined ? { depthParam } : {}) });
+  }
+  const hop2 = pickByWords([...plans.keys()], HOP2_TOKENS);
+  return { hop1, ...(hop2 !== undefined ? { hop2: plans.get(hop2) as Hop2Plan } : {}) };
+}
+
+/**
+ * Whether a tool may be called for the inventory: its posture under the
+ * facade's policy is `auto` ("runs immediately") AND the server annotates it
+ * `readOnlyHint: true`. A tool that is auto only because of the
+ * `destructive-only` mode or a developer override is never called.
+ */
+export function isInventoryEligible(entry: ToolCatalogEntry, decision: string): boolean {
+  const annotations: unknown = entry.annotations;
+  const readOnly =
+    typeof annotations === 'object' &&
+    annotations !== null &&
+    Object.hasOwn(annotations, 'readOnlyHint') &&
+    (annotations as Record<string, unknown>)['readOnlyHint'] === true;
+  return decision === 'auto' && readOnly;
+}
+
+// --- Parsing a listing result into names -----------------------------------
+
+/** Scan at most this many raw entries before capping (bounds work on a huge listing). */
+const MAX_SCAN = 200;
+/** A line longer than this, or with more words, is prose, not a name. */
+const MAX_LINE_CHARS = 200;
+const MAX_LINE_WORDS = 6;
+const NAME_KEYS = ['name', 'path', 'full_name', 'fullName', 'title', 'id', 'key'];
+const DIR_TYPES = new Set(['dir', 'directory', 'folder', 'tree']);
+
+function lineEntry(raw: string): string | undefined {
+  let line = raw.trim();
+  if (line.length === 0 || line.length > MAX_LINE_CHARS) return undefined;
+  line = line.replace(/^(?:[-*•]\s+)/, '');
+  let dir = false;
+  const tagged = /^\[([A-Za-z]+)\]\s+(.+)$/.exec(line);
+  if (tagged !== null) {
+    dir = DIR_TYPES.has((tagged[1] as string).toLowerCase());
+    line = (tagged[2] as string).trim();
+  }
+  // A header ("Allowed directories:") or prose, not a name.
+  if (line.endsWith(':') || line.split(/\s+/).length > MAX_LINE_WORDS) return undefined;
+  return dir && !line.endsWith('/') ? `${line}/` : line;
+}
+
+function objectEntry(item: Record<string, unknown>): string | undefined {
+  for (const key of NAME_KEYS) {
+    const value = item[key];
+    if (typeof value === 'string' && value.trim().length > 0) {
+      const name = value.trim();
+      const type = item['type'];
+      const dir =
+        (typeof type === 'string' && DIR_TYPES.has(type.toLowerCase())) ||
+        item['isDirectory'] === true;
+      return dir && !name.endsWith('/') ? `${name}/` : name;
+    }
+  }
+  return undefined;
+}
+
+function isTextBlock(value: unknown): value is { type: 'text'; text: string } {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    (value as Record<string, unknown>)['type'] === 'text' &&
+    typeof (value as Record<string, unknown>)['text'] === 'string'
+  );
+}
+
+function collect(value: unknown, out: string[], depth: number): void {
+  if (out.length >= MAX_SCAN || depth > 3) return;
+  if (typeof value === 'string') {
+    const trimmed = value.trim();
+    if (/^[[{]/.test(trimmed)) {
+      try {
+        collect(JSON.parse(trimmed) as unknown, out, depth + 1);
+        return;
+      } catch {
+        // Not JSON: read it as lines.
+      }
+    }
+    for (const line of trimmed.split(/\r?\n/)) {
+      if (out.length >= MAX_SCAN) return;
+      const entry = lineEntry(line);
+      if (entry !== undefined) out.push(entry);
+    }
+    return;
+  }
+  if (Array.isArray(value)) {
+    for (const item of value) {
+      if (out.length >= MAX_SCAN) return;
+      if (typeof item === 'string') {
+        const entry = lineEntry(item);
+        if (entry !== undefined) out.push(entry);
+      } else if (isTextBlock(item)) {
+        collect(item.text, out, depth + 1);
+      } else if (typeof item === 'object' && item !== null) {
+        const entry = objectEntry(item as Record<string, unknown>);
+        if (entry !== undefined) out.push(entry);
+      }
+    }
+    return;
+  }
+  if (typeof value === 'object' && value !== null) {
+    if (isTextBlock(value)) {
+      collect(value.text, out, depth + 1);
+      return;
+    }
+    // The first non-empty list it holds, else a multi-line string (a
+    // structured `{ content: "[FILE] a\n[DIR] b" }`).
+    const fields = Object.values(value as Record<string, unknown>);
+    const list = fields.find((field) => Array.isArray(field) && field.length > 0);
+    if (list !== undefined) {
+      collect(list, out, depth + 1);
+      return;
+    }
+    const text = fields.find((field) => typeof field === 'string' && field.includes('\n'));
+    if (text !== undefined) collect(text, out, depth + 1);
+  }
+}
+
+/** The raw names a listing result holds, in the server's order (unsanitized). */
+export function listingEntries(result: unknown): string[] {
+  const out: string[] = [];
+  collect(result, out, 0);
+  return out;
+}
+
+// --- Rendering --------------------------------------------------------------
+
+const PLAIN_NAME = /^[A-Za-z0-9._@+/-]{1,64}$/;
+
+/**
+ * One name, inert (S5): raw when it is made only of path-safe characters,
+ * else stripped of invisible characters, neutralized, backticks replaced,
+ * capped and JSON-quoted. `undefined` when nothing usable remains.
+ */
+export function inertName(name: string): string | undefined {
+  if (PLAIN_NAME.test(name)) return name;
+  const cleaned = neutralizeControlChars(stripInvisible(name.slice(0, 4 * MAX_INVENTORY_NAME_CHARS)))
+    .replace(/`/g, "'")
+    .replace(/�{2,}/g, '�')
+    .trim();
+  if (/^[\s�]*$/u.test(cleaned)) return undefined;
+  return JSON.stringify(capLength(cleaned, MAX_INVENTORY_NAME_CHARS));
+}
+
+/** Sanitize and cap `names`: at most {@link MAX_INVENTORY_ENTRIES}, {@link MAX_INVENTORY_CHARS} in all. */
+export function capInventory(names: readonly string[]): { names: string[]; more: boolean } {
+  const kept: string[] = [];
+  let chars = 0;
+  let more = false;
+  const seen = new Set<string>();
+  for (const name of names) {
+    const safe = inertName(name);
+    if (safe === undefined || seen.has(safe)) continue;
+    const cost = safe.length + (kept.length > 0 ? 2 : 0);
+    if (kept.length >= MAX_INVENTORY_ENTRIES || chars + cost > MAX_INVENTORY_CHARS) {
+      more = true;
+      break;
+    }
+    seen.add(safe);
+    kept.push(safe);
+    chars += cost;
+  }
+  return { names: kept, more };
+}
+
+/** The inventory line for sanitized names: the label, the names, and `…` when cut. */
+export function renderInventory(inventory: BoxInventory): string {
+  return `${INVENTORY_LABEL} ${inventory.names.join(', ')}${inventory.more ? ' …' : ''}`;
+}
+
+/** A gathered, sanitized inventory. */
+export interface BoxInventory {
+  /** Sanitized names (raw or JSON-quoted), at most {@link MAX_INVENTORY_ENTRIES}. */
+  readonly names: readonly string[];
+  /** True when the listing held more than is shown. */
+  readonly more: boolean;
+}
+
+// --- Gathering ----------------------------------------------------------------
+
+async function callWithin(
+  call: InventoryCall,
+  name: string,
+  args: Record<string, unknown>,
+  timeoutMs: number,
+): Promise<unknown> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<undefined>((resolve) => {
+    timer = setTimeout(() => resolve(undefined), timeoutMs);
+  });
+  try {
+    const outcome = await Promise.race([
+      call(name, args).catch(() => undefined),
+      timeout,
+    ]);
+    return outcome !== undefined && outcome.ok ? outcome.result : undefined;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+/**
+ * Gather a box's inventory with at most two read-only calls (see the module
+ * comment). `tools` are the box's inventory-eligible tools (bare names,
+ * {@link isInventoryEligible}); `call` runs one of them. Resolves to
+ * `undefined` — never rejects — when there is nothing to show.
+ */
+export async function gatherInventory(
+  tools: readonly ToolCatalogEntry[],
+  call: InventoryCall,
+  options: InventoryOptions = {},
+): Promise<BoxInventory | undefined> {
+  try {
+    const timeoutMs = options.timeoutMs ?? INVENTORY_CALL_TIMEOUT_MS;
+    const { hop1, hop2 } = selectInventoryTools(tools);
+    if (hop1 === undefined) return undefined;
+    const first = listingEntries(await callWithin(call, hop1.name, {}, timeoutMs));
+    if (first.length === 0) return undefined;
+    let names = first;
+    if (hop2 !== undefined) {
+      const location = (first[0] as string).replace(/(.)\/$/, '$1');
+      const args: Record<string, unknown> = { [hop2.param]: location };
+      if (hop2.depthParam !== undefined) args[hop2.depthParam] = 1;
+      const second = listingEntries(await callWithin(call, hop2.entry.name, args, timeoutMs));
+      if (second.length > 0) names = second;
+    }
+    const inventory = capInventory(names);
+    return inventory.names.length > 0 ? inventory : undefined;
+  } catch {
+    return undefined;
+  }
+}
